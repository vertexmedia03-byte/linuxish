// ARM64 Guest Architecture Configuration
// Include this in your target's xcconfig to build with ARM64 guest support

// Define the guest architecture
GUEST_ARCH = arm64

// Add the GUEST_ARM64 preprocessor macro for both meson and Xcode builds
ISH_GUEST_DEFINES = GUEST_ARM64=1
// NOTE: Do NOT use $(inherited) here — the project-level GuestX86.xcconfig
// sets GUEST_X86=1, and both defines being active breaks #if GUEST_X86 checks.
// ARM64 targets bypass the Project{Debug,Release}.xcconfig chain, so DEBUG=1
// must be set explicitly per build configuration. Release variants leave it
// unset so DEBUG-gated code (e.g. DebugServer) is fully excluded.
// Set ISH_PROFILE_DEFINE=ISH_PROFILE=1 for diagnostic profiling builds.
ISH_PROFILE_DEFINE =
GCC_PREPROCESSOR_DEFINITIONS = GUEST_ARM64=1 $(ISH_PROFILE_DEFINE)
GCC_PREPROCESSOR_DEFINITIONS[config=Debug-ApplePleaseFixFB19282108] = GUEST_ARM64=1 DEBUG=1 $(ISH_PROFILE_DEFINE)
GCC_PREPROCESSOR_DEFINITIONS[config=DebugLinux] = GUEST_ARM64=1 DEBUG=1 $(ISH_PROFILE_DEFINE)

// Meson options for ARM64 guest
MESON_GUEST_OPTION = -Dguest_arch=arm64

// YES builds libish with the native JIT (meson -Djit=true, see
// asbestos/guest-arm64/jit.h). Runtime translation needs executable memory;
// iOS builds require a jailbroken/JIT-enabled environment. If allocation is
// denied at runtime, execution falls back to gadgets unless strict mode is
// enabled. Strict mode aborts on untranslated guest blocks; it does not remove
// gadget helpers used for Linux syscalls and slow paths. Set NO for AOT-only
// builds that run linked images (aot_<name>.S from tools/jit_aot/gen.py, see
// asbestos/guest-arm64/aot.h) without mapping executable memory.
ISH_ENABLE_JIT = YES
ISH_JIT_EMIT = YES
ISH_JIT_STRICT = YES

// ARM64 rootfs URL (Alpine 3.21 aarch64 minirootfs)
ROOTFS_URL = dl-cdn.alpinelinux.org/alpine/v3.21/releases/aarch64/alpine-minirootfs-3.21.0-aarch64.tar.gz
